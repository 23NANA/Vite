# 复制一份为 backend/.env，把下面的值换成自己的
# cp .env.example .env

# 数据库连接（MySQL）
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/lab_agent?charset=utf8mb4

# JWT 配置，JWT_SECRET_KEY 请换成一串随机字符串
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 大模型配置（兼容 OpenAI 接口的服务都可以）
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
