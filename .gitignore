# ---------- 依赖 ----------
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# ---------- 构建产物 / 缓存 ----------
dist/
*.local
.eslintcache
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ---------- 测试产物 ----------
e2e/playwright-report/
e2e/test-results/
# Allure 原始结果和 HTML 报告都是生成物，不进版本库
backend/allure-results/
backend/allure-report/

# ---------- 环境变量 ----------
# backend/.env 里有数据库密码、JWT 密钥和 LLM API Key，绝对不能提交
backend/.env
.env.local
*.env.local

# ---------- 部署打包 ----------
# deploy/ 是服务器部署用的打包副本（含向量库、上传文件、zip），源码以 backend/ 为准
deploy/

# ---------- 运行时数据 ----------
# 向量库是 RAG 建索引时生成的，删掉后可以重新生成；data/kb 里的原始文档要保留
backend/data/chroma/
backend/uploads/
backend/*.db
backend/*.sqlite3

# ---------- 编辑器 / 系统 ----------
.idea/
.DS_Store
Thumbs.db
*.log
